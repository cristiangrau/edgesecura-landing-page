---
const faqs = [
  {
    q: "How is this different from a traditional IGA suite?",
    a: "Traditional IGA was built around the employee record. EdgeSecura is purpose-built for the identities your HRIS does not own — contractors, partners, vendors, and machine-to-machine identities — and integrates with your existing IGA where one is in place.",
  },
  {
    q: "Do you replace our identity provider?",
    a: "No. EdgeSecura sits above your identity provider and SaaS catalog. Your existing IdP remains the source of truth for authentication; we govern provisioning and lifecycle.",
  },
  {
    q: "How do you handle SoD and certification campaigns?",
    a: "Workflows run on a durable engine, so multi-step approvals and quarterly reviews are first-class. Every decision and signer is recorded.",
  },
  {
    q: "What does deployment look like?",
    a: "Most customers are in production inside two weeks: directory bridge, two pilot workflows, and a first certification cycle. Full rollout is staged from there.",
  },
];
---
<section id="faq" class="border-b border-paper-300 bg-paper-100">
  <div class="mx-auto max-w-4xl px-6 py-20 md:py-24">
    <p class="text-xs uppercase tracking-[0.18em] text-ink-300 mb-4">Frequently asked</p>
    <h2 class="text-3xl md:text-4xl font-semibold leading-tight">Questions buyers ask first.</h2>

    <div class="mt-10 divide-y divide-paper-300 border-t border-b border-paper-300">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex items-start justify-between cursor-pointer list-none">
            <span class="text-base font-medium text-ink-900 pr-6">{f.q}</span>
            <span class="text-ink-300 group-open:rotate-45 transition-transform shrink-0 mt-1">+</span>
          </summary>
          <p class="mt-3 text-sm text-ink-500 leading-relaxed max-w-3xl">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
