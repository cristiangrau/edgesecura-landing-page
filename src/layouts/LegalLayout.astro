---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---
<Layout title={`${title} — EdgeSecura`}>
  <article class="mx-auto max-w-3xl px-6 py-20 md:py-24">
    <p class="text-xs uppercase tracking-[0.18em] text-ink-300 mb-4">Legal</p>
    <h1 class="text-3xl md:text-4xl font-semibold leading-tight">{title}</h1>
    <p class="mt-3 text-sm text-ink-300">Last updated: {updated}</p>

    <div class="mt-10 prose prose-sm max-w-none text-ink-700 leading-relaxed
                [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-ink-900
                [&_h3]:text-base [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-ink-900
                [&_p]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_li]:mb-1
                [&_a]:text-accent-500 [&_a]:underline [&_a]:underline-offset-2">
      <slot />
    </div>

    <p class="mt-16 text-xs text-ink-300 border-t border-paper-300 pt-6">
      This document is a placeholder. Replace with the version reviewed by your counsel before going to production.
    </p>
  </article>
</Layout>
